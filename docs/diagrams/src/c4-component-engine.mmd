---
title: "C4 Level 3 — Local decision engine: one selection request"
---
flowchart TB
  adapter["<b>Harness adapter</b><br/>[Component: hook or plugin]<br/>Opening prompt or subagent instructions"]:::comp
  config[("<b>User config</b><br/>[Data store: file]<br/>Allowed list and constraints")]:::cont
  store[("<b>Evidence cache</b><br/>[Data store: results.json]<br/>Typed candidate features")]:::cont
  subgraph engine["Local decision engine — Approach B; input design still open"]
    guard["<b>Request guard</b><br/>[Component: code]<br/>Checks request, schema and freshness"]:::comp
    mask["<b>Hard-constraint filter</b><br/>[Component: code]<br/>Removes ineligible candidates"]:::comp
    serial["<b>Feature preparation</b><br/>[Component: shared library]<br/>Same format in training and runtime;<br/>text vs numeric representation open"]:::comp
    laya["<b>Laya decision model</b><br/>[Component: local learned model]<br/>Scores eligible candidates;<br/>exact ranking-head design open"]:::comp
    calib["<b>Calibrator and ranker</b><br/>[Component: calibration + code]<br/>Teacher-agreement confidence;<br/>top choice and runners-up"]:::comp
    fallback["<b>Native fallback signal</b><br/>[Component: code]<br/>On model failure, leave harness default as-is;<br/>Goldilocks constraints do not apply"]:::comp
    resp["<b>Response assembler</b><br/>[Component: code]<br/>Returns pick, confidence and runners-up;<br/>failure response contract still open"]:::comp
  end
  adapter -->|"Requests pick once [JSON]"| guard
  guard -->|"Passes valid request"| mask
  mask -->|"Reads allowed list and constraints"| config
  mask -->|"Reads candidate features"| store
  mask -->|"Passes eligible candidates and prompt"| serial
  serial -->|"Builds shared model input"| laya
  laya -->|"Produces scores"| calib
  calib -->|"Returns ranked pick or low-confidence status"| resp
  guard -->|"Reports invalid request; handling open"| resp
  mask -->|"Reports no selection and blocking constraints"| resp
  laya -->|"Reports runtime failure or timeout"| fallback
  fallback -->|"Signals native harness fallback"| resp
  resp -->|"Returns pick or fallback status"| adapter
  log[("<b>Mandatory local decision log</b><br/>[Data store: schema open]<br/>Records attempts, outcomes and fallback;<br/>metadata only, no task text")]:::cont
  adapter -->|"Records every attempt, even if engine cannot run"| log
