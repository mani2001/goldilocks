{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "World verdict for one launch story cluster. Key order matters: evidence and claims first, tldr last. Validators should also check key order.",
  "properties": {
    "category": {
      "enum": [
        "model_release",
        "tool",
        "feature_update",
        "funding",
        "research",
        "partnership",
        "other"
      ],
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "affiliated": {
          "description": "True if the story source is the company, its investors, or its PR channel.",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "primary",
            "press",
            "aggregator",
            "social",
            "rumor"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "affiliated"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minimum": 1,
            "type": "integer"
          },
          "independent": {
            "description": "True if the source is not affiliated with the launching company.",
            "type": "boolean"
          },
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "check": {
            "type": "string",
            "enum": [
              "registry"
            ],
            "description": "Set to 'registry' when this item is a deterministic artefact check (the weights/repo/package/pricing page itself), as opposed to a claim made by a source."
          }
        },
        "required": [
          "id",
          "url",
          "independent"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "type": "array"
          },
          "kind": {
            "enum": [
              "benchmark",
              "capability",
              "availability",
              "pricing",
              "adoption"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "self_reported",
              "contradicted",
              "unverifiable"
            ],
            "type": "string"
          }
        },
        "required": [
          "claim",
          "kind",
          "status",
          "evidence_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "access": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array"
        },
        "price_known": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "shipped",
            "beta",
            "waitlist",
            "announced"
          ],
          "type": "string"
        },
        "via": {
          "items": {
            "enum": [
              "api",
              "weights",
              "app",
              "paper",
              "device"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "via",
        "price_known",
        "evidence_ids"
      ],
      "type": "object"
    },
    "delta": {
      "description": "Concrete changes vs prior version or status quo. No marketing adjectives.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "type": "array"
    },
    "prior_art": {
      "description": "Similar existing products. May legitimately be empty. Every entry must cite evidence.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "differs": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "differs",
          "evidence_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "substance": {
      "enum": [
        "new_model",
        "new_capability",
        "integration",
        "wrapper",
        "rebrand",
        "research_only"
      ],
      "type": "string"
    },
    "undisclosed": {
      "items": {
        "enum": [
          "pricing",
          "eval_method",
          "eval_independent",
          "param_count",
          "training_data",
          "license",
          "rate_limits",
          "release_date"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "category_record": {
      "description": "Per-category typed facts. For model_release: params, license, context_length, weights_url, benchmarks_reported, benchmarks_independent. Other categories defined at data-design time.",
      "type": "object"
    },
    "novelty": {
      "description": "1-5 ordinal, rubric-anchored. New to the world.",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "slop": {
      "description": "1-5 ordinal, rubric-anchored. The hype gap: claim strength minus evidence strength.",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "confidence": {
      "enum": [
        "low",
        "med",
        "high"
      ],
      "type": "string"
    },
    "recheck_when": {
      "type": [
        "string",
        "null"
      ]
    },
    "tldr": {
      "description": "The truth in one line, marketing removed. Generated LAST.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "category",
    "source",
    "evidence",
    "claims",
    "access",
    "delta",
    "prior_art",
    "substance",
    "undisclosed",
    "category_record",
    "novelty",
    "slop",
    "confidence",
    "recheck_when",
    "tldr"
  ],
  "title": "ReceiptsWorldVerdict",
  "type": "object"
}