{
  "name": "goldilocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "evidence": "node --env-file-if-exists=.env scripts/evidence.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts --subagent",
    "start": "node --env-file-if-exists=.env scripts/pi.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/goldilocks.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
